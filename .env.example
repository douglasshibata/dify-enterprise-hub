# Dify Core Encryption & Internal Keys
# Gerar chaves seguras via: openssl rand -base64 42
DIFY_SECRET_KEY=enterprise-dify-secret-encryption-key-change-in-production-32chars

# Database Credentials
DB_USER=dify
DB_PASSWORD=dify_enterprise_secure_pg_pass_2025
DB_NAME=dify_db

# Redis Broker & Cache Credentials
# Gerar via: openssl rand -hex 16
REDIS_PASSWORD=dify_redis_secure_pass_2025

# Vector Database (Qdrant)
QDRANT_API_KEY=qdrant_secure_api_key_2025

# Sandbox Execution Security
# Gerar via: openssl rand -hex 16
SANDBOX_API_KEY=dify-sandbox-secure-token-key

# Enterprise Tools API Authentication
# Gerar via: openssl rand -hex 16
TOOLS_API_KEY=erp-enterprise-secure-token-2025
